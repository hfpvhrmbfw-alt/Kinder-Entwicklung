{
  "name": "kleine-schritte",
  "version": "0.12.0",
  "private": true,
  "description": "PWA zur Begleitung der Kindesentwicklung (0–7 Jahre). Offline, ohne Konto, ohne Tracker.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:content": "vitest run tests/content.test.ts",
    "cms:config": "node scripts/pages-config.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "idb": "^8.0.4"
  }
}
