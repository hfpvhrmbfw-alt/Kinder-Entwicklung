    "steps": [
      {
        "de": "Malt gemeinsam Kästchen mit Kreide auf den Gehweg oder Hof und schreibt Zahlen hinein."
      },
      {
        "de": "Hüpft auf einem Bein in Einzelkästchen und mit beiden Füßen in Doppelkästchen."
      },
      {
        "de": "Am Ende umdrehen und zurück."
      }
    ],
    "variations": {
