    "steps": [
      {
        "de": "Stell einen stabilen Tritthocker ans Waschbecken und häng ein Handtuch in Reichweite."
      },
      {
        "de": "Singt ein kurzes Lied, während eingeseift und gerieben wird (vorn, hinten, zwischen den Fingern)."
      },
      {
        "de": "Abspülen, abtrocknen, fertig."
      }
    ],
    "variations": {
      "easier": [
        {
          "de": "Du führst die Hände, dein Kind reibt."
        }
      ],
      "harder": [
        {
          "de": "Dein Kind macht es allein und erinnert dich daran."
        }
      ]
    },
    "guidanceTips": [
      {
        "de": "Gleiche Reihenfolge und gleiches Lied helfen beim Merken."
      }
    ],
    "learningOutcomes": [
      {
        "de": "Übernimmt eine Pflegeaufgabe selbst."
      },
      {
        "de": "Lernt eine Abfolge."
      }
    ],
    "rationale": {
      "de": "Feste Abläufe in kindgerechter Umgebung fördern Selbstständigkeit und gesunde Gewohnheiten."
    },
    "safety": [
      {
