  {
    "id": "a-homemade-playdough",
    "origin": "builtin",
    "title": {
      "de": "Knete selbst machen"
    },
    "summary": {
      "de": "Aus Mehl, Salz und Wasser entsteht weiche Knete."
    },
    "ageRange": {
      "minMonths": 24,
      "maxMonths": 72
    },
    "domains": {
      "primary": "fineMotor",
      "secondary": [
        "cognition",
        "selfCare"
      ]
    },
    "category": "craft",
    "durationMinutes": {
      "min": 20,
      "max": 40
    },
    "location": "indoor",
    "prepEffort": "medium",
    "socialSettings": [
      "oneOnOne",
      "siblings",
      "group"
    ],
    "materials": [
      {
        "materialId": "flour",
        "optional": false
      },
      {
        "materialId": "salt",
        "optional": false
      },
      {
        "materialId": "water",
        "optional": false
      },
      {
        "materialId": "bowls",
        "optional": false
      }
    ],
    "steps": [
      {
        "de": "Misch gemeinsam 2 Tassen Mehl, 1 Tasse Salz und nach und nach etwa 1 Tasse Wasser (bei Bedarf 1 EL Öl)."
      },
      {
        "de": "Lass dein Kind kneten, bis ein glatter Teig entsteht."
      },
      {
        "de": "Rollt Schlangen, formt Kugeln, drückt Muster hinein."
      }
    ],
    "variations": {
      "easier": [
        {
          "de": "Fertige Knete nehmen und nur drücken und reißen."
        }
      ],
      "harder": [
        {
          "de": "Mit Ausstechformen und Kinderbesteck schneiden oder Buchstaben formen."
        }
      ]
    },
    "guidanceTips": [
      {
        "de": "Mitmischen ist schon die halbe Beschäftigung."
      }
    ],
    "learningOutcomes": [
      {
        "de": "Kräftigt Hand- und Fingermuskeln."
      },
      {
        "de": "Erlebt Mengen und Veränderung beim Mischen."
      }
    ],
    "rationale": {
      "de": "Kneten trainiert Kraft und Geschicklichkeit der Hände, die später beim Malen und Schreiben gebraucht werden; das Mischen macht Mengen und Stoffe erlebbar."
    },
    "safety": [
      {
        "kind": "other",
        "text": {
          "de": "Salzknete nicht essen lassen: Größere Mengen Salz sind für Kinder und Haustiere gefährlich."
        }
      },
      {
        "kind": "allergy",
        "text": {
          "de": "Enthält Weizenmehl (Gluten)."
        }
      },
      {
        "kind": "water",
        "text": {
          "de": "Wasserschüssel nach dem Mischen wegräumen."
        }
      }
    ],
    "references": [
      {
        "referenceId": "yogman-2018"
      },
      {
        "referenceId": "montessori-practical-life"
      }
    ],
    "relatedMilestoneIds": [
      "fm-twists",
      "fm-uses-scissors"
    ],
    "review": {
      "status": "needsCheck",
      "note": "Rezeptmengen und Hinweis zur Salzknete prüfen."
    }
  },
  {
    "id": "a-color-sorting",
    "origin": "builtin",
    "title": {
      "de": "Farben-Sortieren"
    },
    "summary": {
      "de": "Bunte Dinge kommen in passende Schüsseln."
    },
    "ageRange": {
      "minMonths": 24,
      "maxMonths": 48
    },
    "domains": {
      "primary": "cognition",
      "secondary": [
        "language",
        "fineMotor"
      ]
    },
    "category": "play",
    "durationMinutes": {
      "min": 5,
      "max": 15
    },
    "location": "indoor",
    "prepEffort": "low",
    "socialSettings": [
      "oneOnOne",
      "siblings"
    ],
    "materials": [
      {
        "materialId": "bowls",
        "optional": false
      },
      {
        "materialId": "blocks-large",
        "optional": false
      },
      {
        "materialId": "socks",
        "optional": true
      }
    ],
    "steps": [
      {
        "de": "Stell zwei Schüsseln auf, z. B. eine rote und eine blaue (oder leg ein farbiges Papier hinein)."
      },
      {
        "de": "Mischt bunte Bausteine oder Socken auf dem Boden."
      },
      {
        "de": "Sortiert gemeinsam: „Der ist rot, der kommt hierhin.“"
      }
    ],
    "variations": {
      "easier": [
        {
          "de": "Nur zwei Farben."
        }
      ],
      "harder": [
        {
          "de": "Mehr Farben oder nach Form und Größe sortieren."
        }
      ]
    },
    "guidanceTips": [
      {
        "de": "Fehler nicht korrigieren, sondern fragen: „Ist der auch blau?“"
      }
    ],
    "learningOutcomes": [
      {
        "de": "Ordnet nach einer Eigenschaft."
      },
      {
        "de": "Lernt Farbwörter."
      }
    ],
    "rationale": {
      "de": "Sortieren ist eine frühe Form des Denkens in Kategorien und eine Grundlage für Mengenverständnis."
    },
    "safety": [],
    "references": [
      {
        "referenceId": "piaget-1952"
      }
    ],
    "relatedMilestoneIds": [
      "co-sorts",
      "co-names-colors"
    ],
