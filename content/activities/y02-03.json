    "steps": [
      {
        "de": "Verabredet euch mit einer anderen Familie auf dem Spielplatz."
      },
      {
        "de": "Lass die Kinder nebeneinander spielen, ohne gemeinsames Spiel zu erzwingen."
      },
      {
        "de": "Hilf beim Abwechseln: „Erst Ben, dann du.“"
      }
    ],
    "variations": {
      "easier": [
        {
          "de": "Nur zuschauen dürfen ist auch okay."
        }
      ],
      "harder": [
