        "materialId": "ball-soft",
        "optional": false
      }
    ],
    "steps": [
      {
        "de": "Stellt euch nah gegenüber, etwa einen großen Schritt Abstand."
      },
      {
        "de": "Wirf den Ball sanft von unten in die ausgestreckten Arme."
      },
      {
        "de": "Nach jedem Fang einen Schritt zurück."
      }
    ],
    "variations": {
      "easier": [
        {
          "de": "Ball rollen statt werfen, oder Arme vorher als „Korb“ formen."
        }
      ],
      "harder": [
        {
          "de": "Kleineren Ball verwenden oder nach einmal Aufprellen fangen."
        }
      ]
    },
    "guidanceTips": [
      {
        "de": "Lob für das Versuchen, nicht nur fürs Fangen."
      }
    ],
    "learningOutcomes": [
      {
        "de": "Stimmt Augen und Hände ab."
      },
      {
        "de": "Schätzt Flugbahnen ein."
      }
    ],
    "rationale": {
      "de": "Fangen verlangt, Bewegungen vorherzusehen und Augen und Hände zu koordinieren."
    },
    "safety": [
      {
        "kind": "other",
        "text": {
          "de": "Weichen Ball verwenden; Abstand zu Fenstern und Möbeln."
        }
      }
    ],
    "references": [
