  {
    "id": "a-ball-catch",
    "origin": "builtin",
    "title": {
      "de": "Ballfangen"
    },
    "summary": {
      "de": "Einen großen, weichen Ball zuwerfen und fangen."
    },
    "ageRange": {
      "minMonths": 30,
      "maxMonths": 60
    },
    "domains": {
      "primary": "grossMotor",
      "secondary": [
        "socialEmotional"
      ]
    },
    "category": "movement",
    "durationMinutes": {
      "min": 5,
      "max": 15
    },
