      },
      {
        "de": "Malt freie Kreise: Sonne, Luftballons, Gesichter."
      }
    ],
    "variations": {
      "easier": [
        {
          "de": "Mit dem Finger in Mehl auf einem Tablett Kreise ziehen."
        }
      ],
      "harder": [
