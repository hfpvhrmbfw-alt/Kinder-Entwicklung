        "materialId": "glue-stick",
        "optional": true
      },
      {
        "materialId": "bowls",
        "optional": true
      }
    ],
    "steps": [
      {
        "de": "Schneide Papier in schmale Streifen, die mit einem Schnitt durchtrennt werden können."
      },
      {
        "de": "Zeig, wie die Schere gehalten wird: Daumen oben."
      },
      {
        "de": "Dein Kind schneidet Schnipsel in eine Schüssel, „Salat“."
      }
    ],
    "variations": {
      "easier": [
        {
          "de": "Nur Einschneiden; du hältst den Streifen."
        }
      ],
      "harder": [
        {
          "de": "An einer dicken, geraden Linie entlangschneiden, später Wellen."
        }
      ]
    },
    "guidanceTips": [
      {
        "de": "Daumen nach oben ist der wichtigste Tipp."
      }
    ],
    "learningOutcomes": [
      {
        "de": "Koordiniert beide Hände unterschiedlich."
      },
      {
        "de": "Kräftigt die Hand."
      }
    ],
    "rationale": {
      "de": "Schneiden fordert, dass eine Hand hält und die andere arbeitet, eine wichtige feinmotorische Fähigkeit vor der Schule."
    },
    "safety": [
      {
        "kind": "sharp",
