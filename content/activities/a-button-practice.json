  "steps": [
    {
      "de": "Leg eine Jacke oder Strickjacke mit großen Knöpfen offen auf den Tisch."
    },
    {
      "de": "Zeig langsam: Knopf halb durchschieben, auf der anderen Seite ziehen."
    },
    {
      "de": "Lass dein Kind üben, erst auf dem Tisch, dann am eigenen Körper."
    }
  ],
  "variations": {
    "easier": [
      {
        "de": "Nur aufknöpfen."
      }
    ],
    "harder": [
      {
        "de": "Kleinere Knöpfe oder ein Hemd."
      }
    ]
  },
  "guidanceTips": [
    {
      "de": "Von unten nach oben knöpfen, dann rutscht nichts schief."
    }
  ],
