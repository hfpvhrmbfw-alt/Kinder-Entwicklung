    "steps": [
      {
        "de": "Breite eine Decke aus und setz Kuscheltiere drumherum."
      },
      {
        "de": "Stell Becher und Schüsseln hin; Bausteine werden zu Essen."
      },
      {
        "de": "Spiel mit: „Teddy hat Hunger! Was gibt es heute?“"
      }
    ],
    "variations": {
      "easier": [
        {
          "de": "Ein Kuscheltier füttern."
        }
      ],
      "harder": [
        {
          "de": "Eine Geschichte entwickeln: Teddy ist traurig, wer tröstet ihn?"
        }
      ]
    },
    "guidanceTips": [
      {
        "de": "Lass dein Kind die Regie führen und folge seinen Ideen."
      }
    ],
    "learningOutcomes": [
      {
        "de": "Nutzt Dinge symbolisch (Baustein = Kuchen)."
      },
      {
        "de": "Übt Sprache und Fürsorge im Spiel."
      }
    ],
    "rationale": {
      "de": "Im Als-ob-Spiel nutzen Kinder innere Vorstellungen. Vygotsky sah darin einen wichtigen Motor für Denken und Selbstregulation."
