  "steps": [
    {
      "de": "Lies eine Seite und halte an."
    },
    {
      "de": "Stell eine offene Frage: „Was macht der Bär da?“"
    },
    {
      "de": "Greif die Antwort auf, lobe sie und erweitere sie mit einem neuen Wort."
    }
  ],
  "variations": {
    "easier": [
      {
        "de": "Nur zeigen und benennen lassen."
      }
    ],
    "harder": [
      {
        "de": "Fragen nach dem Warum und Was-wäre-wenn; Verbindung zum eigenen Leben: „Warst du auch schon mal so wütend?“"
      }
    ]
  },
  "guidanceTips": [
    {
      "de": "Nicht jede Seite abfragen; die Geschichte soll Spaß machen."
    }
  ],
  "learningOutcomes": [
    {
      "de": "Erweitert Wortschatz und Satzbau."
    },
    {
      "de": "Übt Gespräche über Geschichten."
    }
  ],
  "rationale": {
    "de": "Dialogisches Lesen (nach Whitehurst) macht Kinder zu aktiven Erzählern und fördert nachweislich den Wortschatz."
