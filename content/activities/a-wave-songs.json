  "steps": [
    {
      "de": "Sing ein einfaches Lied mit Gesten, z. B. „Winke, winke“ oder „Alle meine Entchen“ mit Handbewegungen."
    },
    {
      "de": "Mach die Gesten deutlich vor."
    },
    {
      "de": "Halte inne, damit dein Kind die Geste selbst zeigen kann."
    }
  ],
  "variations": {
    "easier": [
      {
        "de": "Hände deines Kindes sanft mitführen."
      }
    ],
    "harder": [
      {
        "de": "Neue Gesten einführen, z. B. „Wie groß bist du?“ mit Armen hoch."
      }
    ]
  },
  "guidanceTips": [
    {
      "de": "Gesten im Alltag nutzen: Winken beim Abschied, Arme hoch beim Hochnehmen."
    }
  ],
  "learningOutcomes": [
    {
      "de": "Nutzt Gesten zur Verständigung."
    },
    {
      "de": "Verbindet Wörter und Bewegungen."
    }
  ],
  "rationale": {
