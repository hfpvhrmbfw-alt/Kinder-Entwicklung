    },
    "ageRange": {
      "minMonths": 48,
      "maxMonths": 72
    },
    "domains": {
      "primary": "cognition",
      "secondary": [
        "selfCare",
        "fineMotor"
      ]
    },
    "category": "everyday",
    "durationMinutes": {
